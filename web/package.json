{
  "name": "parapente-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "api": "tsx server/index.ts",
    "db:setup": "../db/setup.sh",
    "db:import:osm": "tsx server/importOsm.ts",
    "db:import:pge": "tsx server/importParaglidingEarth.ts",
    "db:import:elevation": "tsx server/importElevation.ts",
    "db:import:stations": "tsx server/importStations.ts",
    "db:import:lifts": "tsx server/importLifts.ts",
    "db:import:hazards": "tsx server/importHazards.ts",
    "db:import:all": "npm run db:import:osm && npm run db:import:pge && npm run db:import:elevation && npm run db:import:stations && npm run db:import:lifts && npm run db:import:hazards",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.4.1",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "tsx": "^4.20.5",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
